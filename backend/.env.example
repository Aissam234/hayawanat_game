# ==========================================
# Backend Environment Configuration
# ==========================================

# Set to "production" for production deployment (enables stricter CORS & security)
ENVIRONMENT=development

# The URL for the PostgreSQL database
# Local (Docker): postgresql://hayawanat:hayawanat_secret@postgres:5432/hayawanat_db
# Neon Postgres: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://hayawanat:hayawanat_secret@postgres:5432/hayawanat_db

# Security Key for tokens/sessions (Must be changed in production)
# You can generate one using: openssl rand -hex 32
SECRET_KEY=change-me-in-production

# Allowed origins for CORS (comma separated)
# Local: http://localhost:5173
# Production (Vercel): https://your-frontend-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173
