# ==========================================
# Frontend Environment Configuration
# ==========================================

# The URL of the FastAPI backend API
# Local development: http://localhost:8000
# Production (Render): https://your-backend-app.onrender.com
VITE_API_URL=http://localhost:8000

# The WebSocket URL of the FastAPI backend
# Local development: ws://localhost:8000
# Production (Render): wss://your-backend-app.onrender.com
VITE_WS_URL=ws://localhost:8000

# Same public Web client ID as backend GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
